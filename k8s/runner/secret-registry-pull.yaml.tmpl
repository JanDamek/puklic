# Template for the imagePullSecret used by the runner pods to pull from
# registry.damek-soft.eu.
#
# DO NOT commit the realized file (with real values) — `.gitignore` excludes
# `k8s/runner/secret-registry-pull.yaml`.
#
# Preferred path: create directly via kubectl (does not require manual base64):
#
#   kubectl create secret docker-registry puklic-registry-pull \
#     -n puklic-ci \
#     --docker-server=registry.damek-soft.eu \
#     --docker-username=<USER> \
#     --docker-password=<PASS>
#
# Manual template below is provided for reference / GitOps workflows.
apiVersion: v1
kind: Secret
metadata:
  name: puklic-registry-pull
  namespace: puklic-ci
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: <base64-of-docker-config-with-registry-creds>

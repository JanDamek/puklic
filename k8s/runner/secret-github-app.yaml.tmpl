# Template for the GitHub App credentials Secret used by gha-runner-scale-set.
#
# DO NOT commit the realized file (with real values) — `.gitignore` excludes
# `k8s/runner/secret-github-app.yaml`. Copy this template, fill in placeholders
# locally, and apply with `kubectl apply -f k8s/runner/secret-github-app.yaml`.
#
# Preferred path: create directly via kubectl (see README.md §"GitHub App Secret").
#
# Note: gha-runner-scale-set may auto-discover installation_id from app_id;
# keep it set for backward compat.
apiVersion: v1
kind: Secret
metadata:
  name: puklic-runner-github-app
  namespace: puklic-ci
type: Opaque
stringData:
  github_app_id: "<APP_ID>"
  github_app_installation_id: "<INSTALL_ID>"
  github_app_private_key: |
    -----BEGIN RSA PRIVATE KEY-----
    <REPLACE>
    -----END RSA PRIVATE KEY-----

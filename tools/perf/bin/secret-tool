#!/bin/sh
# File-backed stand-in for libsecret's `secret-tool`, so the perf harness can run the app
# logged in on a machine without a D-Bus session or keyring. Secrets live in $PERF_SECRET_DIR.
command="$1"
shift
for last; do :; done
store_file="${PERF_SECRET_DIR:?PERF_SECRET_DIR must be set}/$(printf '%s' "$last" | tr -c 'A-Za-z0-9._-' '_')"
case "$command" in
    store) mkdir -p "$PERF_SECRET_DIR" && cat > "$store_file" ;;
    lookup) [ -f "$store_file" ] && cat "$store_file" || exit 1 ;;
    clear) rm -f "$store_file" ;;
    *) exit 2 ;;
esac

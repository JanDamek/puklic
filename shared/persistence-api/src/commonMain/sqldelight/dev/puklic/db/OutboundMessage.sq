CREATE TABLE outbound_message (
    local_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    channel_id INTEGER NOT NULL,
    content TEXT NOT NULL,
    attachments_json TEXT NOT NULL DEFAULT '[]',
    reference_message_id INTEGER,
    nonce TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    state INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (channel_id) REFERENCES channel(id) ON DELETE CASCADE
);

CREATE INDEX outbound_state_idx ON outbound_message(state, created_at);

selectPending:
SELECT * FROM outbound_message WHERE state = 0 ORDER BY created_at ASC;

selectAll:
SELECT * FROM outbound_message ORDER BY created_at ASC;

selectById:
SELECT * FROM outbound_message WHERE local_id = ?;

enqueue:
INSERT INTO outbound_message(channel_id, content, attachments_json, reference_message_id, nonce, created_at, attempt_count, last_error, state)
VALUES (?, ?, ?, ?, ?, ?, 0, NULL, 0);

lastInsertRowId:
SELECT last_insert_rowid();

markSending:
UPDATE outbound_message SET state = 1 WHERE local_id = ?;

markFailed:
UPDATE outbound_message SET state = 2, attempt_count = attempt_count + 1, last_error = ? WHERE local_id = ?;

delete:
DELETE FROM outbound_message WHERE local_id = ?;

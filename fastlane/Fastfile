# Fastfile — Puklic iOS TestFlight upload pipeline.
#
# Required environment variables (set by CI or local shell — never inline):
#
#   ASC_KEY_ID            App Store Connect API Key ID (currently active: 6C6D4D726S)
#   ASC_ISSUER_ID         App Store Connect Issuer UUID (69a6de7f-7dab-47e3-e053-5b8c7c11a4d1)
#   ASC_KEY_PATH          Absolute path to ASC API .p8 file
#                         (local default: ~/.appstoreconnect/private_keys/AuthKey_6C6D4D726S.p8)
#   TEAM_ID               Apple Developer Team ID (GR74KSG8M9)
#   BUNDLE_ID             iOS bundle identifier (cz.damek.puklic.app)
#
# Optional:
#   GITHUB_RUN_NUMBER     Monotonic build number for TestFlight (default: timestamp).
#
# Reference:
#   docs/03_infrastructure/architect-reports/2026-05-28-apple-distribution.md §5
#   https://docs.fastlane.tools/actions/pilot/
#   https://docs.fastlane.tools/app-store-connect-api/

default_platform(:ios)

REQUIRED_ENV = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH TEAM_ID BUNDLE_ID].freeze

before_all do
  missing = REQUIRED_ENV.reject { |k| ENV[k] && !ENV[k].empty? }
  UI.user_error!("Missing required env vars: #{missing.join(', ')}") unless missing.empty?
end

platform :ios do
  desc "Build iOS framework, archive, export, and upload to TestFlight (internal)."
  lane :beta do
    # 1. Build the Kotlin/Native framework via Gradle (also gated by Xcode's
    #    embedAndSignAppleFrameworkForXcode pre-build script — re-running here is
    #    idempotent and ensures the framework exists for a fresh CI checkout).
    sh("cd .. && ./gradlew :ios:app:linkReleaseFrameworkIosArm64")

    # 2. Set build number to CI run number (monotonic) or current epoch.
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s
    increment_build_number(
      build_number: build_number,
      xcodeproj: File.expand_path("../iosApp/iosApp.xcodeproj", __dir__)
    )

    # 3. App Store Connect API key for non-interactive auth.
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      duration: 1200, # 20 min, Apple max
      in_house: false
    )

    # 4. Build + archive.
    build_app(
      project: File.expand_path("../iosApp/iosApp.xcodeproj", __dir__),
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: File.expand_path("../dist/apple/ExportOptions-AppStore.filled.plist", __dir__),
      clean: true,
      output_directory: File.expand_path("../build/ios-archive", __dir__),
      output_name: "Puklic.ipa"
    )

    # 5. Upload to TestFlight (internal testers only; no external review submission).
    pilot(
      api_key: api_key,
      ipa: File.expand_path("../build/ios-archive/Puklic.ipa", __dir__),
      skip_waiting_for_build_processing: true,
      skip_submission: true, # do not submit for external beta review
      changelog: "Internal build #{build_number}"
    )
  end

  # ── Local-only split lanes (HARD RULE #4, 2026-05-31) ──────────────────────
  # `build_only` archives + exports to ../build/ios-archive/Puklic.ipa.
  # `upload_only` takes that .ipa and ships it to TestFlight (internal).
  # The original `:beta` lane stays as the single-shot equivalent.

  desc "Archive iOS app to ../build/ios-archive/Puklic.ipa via dist/apple/build-ipa.sh (no upload)."
  lane :build_only do
    # Delegated to a shell script (issue #73). fastlane's `build_app` (gym)
    # invokes a buggy Xcode 26.5 codesign command that misreports
    # `embedded.mobileprovision` as an unsigned code subcomponent. The
    # script archives without signing, then runs `codesign --deep` directly
    # and zips the Payload manually — full control over signing.
    sh("../dist/apple/build-ipa.sh")
  end

  desc "Upload an existing ../build/ios-archive/Puklic.ipa to TestFlight (internal)."
  lane :upload_only do
    ipa_path = ENV["IPA_PATH"] || "../build/ios-archive/Puklic.ipa"
    UI.user_error!("IPA missing: #{ipa_path}") unless File.exist?(ipa_path)

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    pilot(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      changelog: "Local internal build #{Time.now.to_i}"
    )
  end

  desc "Smoke-check ASC API connectivity (no upload)."
  lane :asc_ping do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )
    UI.success("ASC API key loaded: KID=#{ENV['ASC_KEY_ID']}, issuer=#{ENV['ASC_ISSUER_ID']}")
    UI.message("Verify with: ~/.appstoreconnect/asc_api.sh apps")
  end
end

# ── Mac App Store ────────────────────────────────────────────────────────────
# JVM Compose Desktop variant packaged as a sandboxed + notarised .pkg, signed
# with Mac App Distribution + Mac Installer Distribution certs, uploaded to
# App Store Connect app 6774288340 macOS platform via altool / notarytool.
#
# Required env vars (in addition to the ones already required by :ios beta):
#
#   MAC_APP_DIST_P12_BASE64      Mac App Distribution cert + private key bundle
#   MAC_APP_DIST_P12_PASSWORD    Password chosen during .p12 export
#   MAC_INSTALLER_DIST_P12_BASE64    Mac Installer Distribution cert bundle
#   MAC_INSTALLER_DIST_P12_PASSWORD  Password
#   MAC_PROVISIONING_PROFILE_BASE64  App Store provisioning profile
#   MAC_KEYCHAIN_PASSWORD        Throwaway temp keychain password (CI side)
#
# Architect reports:
#   docs/03_infrastructure/architect-reports/2026-05-29-fp14a-mac-app-store-architect.md
#   docs/03_infrastructure/architect-reports/2026-05-29-fp14d-gradle-packaging.md

platform :mac do
  desc "Build, sign, package, and upload Puklic to Mac App Store."
  lane :mac_app_store do
    # FP-14f-fix (F-15): no `setup_ci` — the GitHub Actions workflow already
    # provisions `build.keychain` and sets it as default-keychain.
    # `setup_ci` would create a competing `fastlane_tmp_keychain` and
    # potentially shadow the Mac Installer Distribution cert during
    # productbuild.

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    # Verify no GPL transitives in the macAppStore source set before packaging.
    sh("cd .. && ./gradlew :desktop:app:verifyMacAppStoreNoGplDeps")
    sh("cd .. && ./gradlew :desktop:app:packageMacAppStore")

    # packageMacAppStore output lives under build/macAppStore/pkg/ per FP-14d.
    macAppStorePkgDir = "../desktop/app/build/macAppStore/pkg"
    pkg = Dir["#{macAppStorePkgDir}/Puklic-*.pkg"].first
    UI.user_error!("No Mac App Store .pkg found in #{macAppStorePkgDir}/") if pkg.nil?

    upload_to_app_store(
      api_key: api_key,
      pkg: pkg,
      platform: "osx",
      skip_metadata: true,
      skip_screenshots: true,
      submission_information: nil,
      precheck_include_in_app_purchases: false
    )
  end
end

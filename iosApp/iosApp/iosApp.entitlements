<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>production</string>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)cz.damek.puklic.app</string>
    </array>
    <!-- TODO(#75): enable after Apple Developer Portal "Associated Domains" capability is
         switched on for cz.damek.puklic.app AND the Puklic App Store provisioning
         profile has been regenerated. The same provisioning profile that codesign
         currently uses (UUID e9ae0eef-…) does NOT include this entitlement.
         Once both are done, uncomment the array below. Runbook:
         docs/03_infrastructure/architect-reports/2026-06-01-ios-associated-domains.md
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>webcredentials:discord.com</string>
    </array>
    -->
</dict>
</plist>

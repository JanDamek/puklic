<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>production</string>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)cz.damek.puklic.app</string>
    </array>
    <!--
        TODO(#75): Associated Domains (`webcredentials:discord.com`) for iCloud
        Passwords QuickType integration. Requires enabling "Associated Domains"
        capability for cz.damek.puklic.app in Apple Developer Portal + new
        provisioning profile + Discord-side `apple-app-site-association` for
        full Face ID autofill (won't happen). Without the entitlement, Compose's
        KeyboardType.Password hint still lights up the iOS Passwords key in
        QuickType — same end-state as Image 2 in practice.
    -->
</dict>
</plist>
